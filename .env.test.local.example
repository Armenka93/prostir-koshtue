# Copy this file to .env.test.local and fill in real values.
# .env.test.local is git-ignored — never commit real credentials.
#
# Used ONLY by tests/add-listing-validation.spec.ts. If left unset, that
# test skips itself automatically — no account is ever created by the
# test suite itself.
#
# Requirements for the account referenced below:
#   - It must already exist (sign up manually through the app first).
#   - It must have a phone number set on the profile — AddListingScreen
#     blocks the form entirely for accounts without one.
#   - Use a dedicated test/QA account, not a real user's account, since
#     this test signs in as this user (read-only — it never publishes
#     a listing, but it does authenticate as them).

TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional: override the URL the tests run against (defaults to
# http://localhost:3000, i.e. the local `next dev` server that
# playwright.config.ts starts automatically).
# PLAYWRIGHT_BASE_URL=http://localhost:3000
